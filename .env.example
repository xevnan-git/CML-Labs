# Copy to .env (git-ignored) and fill in. Used by tools/import_lab.py and tools/cml_teardown_lab.py.
CML_URL=https://cml.example.internal
CML_USERNAME=your-cml-username
CML_PASSWORD=your-cml-password
# The CML server uses a self-signed certificate; set to true once a trusted cert is installed.
CML_VERIFY_SSL=false
